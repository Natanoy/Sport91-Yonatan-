rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ortegayonatan426@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      ) && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'ortegayonatan426@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'balance', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.displayName is string &&
             data.balance is number &&
             data.balance >= 0 &&
             data.createdAt is timestamp;
    }

    function isValidBet(data) {
      return data.userId == request.auth.uid &&
             data.amount is number &&
             data.amount > 0 &&
             data.roi is number &&
             data.status == 'pending' &&
             data.createdAt is timestamp &&
             isValidId(data.matchId);
    }

    function isValidWithdrawal(data) {
      return data.userId == request.auth.uid &&
             data.amount is number &&
             data.amount >= 10 &&
             data.fee is number &&
             data.netAmount == data.amount - data.fee &&
             data.address is string &&
             data.address.size() >= 20 &&
             data.network is string &&
             data.status == 'pending' &&
             data.createdAt is timestamp;
    }

    function isValidLuckyBox(data) {
      return (data.get('balance', 0) is number) &&
             (data.get('lastLuckyBoxClaim', '') is string) &&
             (data.get('lotteryTickets', 0) is number) &&
             (data.get('updatedAt', request.time) == request.time);
    }

    // --- Collection Rules ---
    
    // System Metadata (for sync tracking)
    match /system/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && (
        // Action: Profile Update
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])) ||
        // Action: Daily Check-In
        (incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'checkInStreak', 'lastCheckInDate', 'updatedAt']) &&
        incoming().balance >= existing().balance &&
        incoming().checkInStreak >= existing().checkInStreak &&
        incoming().updatedAt == request.time) ||
        // Action: Lucky Box
        (incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'lastLuckyBoxClaim', 'lotteryTickets', 'updatedAt']) &&
        isValidLuckyBox(incoming())) ||
        // Action: Withdrawal (Decrease balance)
        (incoming().diff(existing()).affectedKeys().hasOnly(['balance']) &&
        incoming().balance < existing().balance)
      )) || isAdmin();
    }

    // Matches
    match /matches/{matchId} {
      allow read, list: if true;
      allow write: if isSignedIn();
    }

    // Bets
    match /bets/{betId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidBet(incoming()) && 
                    exists(/databases/$(database)/documents/matches/$(incoming().matchId));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Support Tickets
    match /tickets/{ticketId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidWithdrawal(incoming()) && 
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance >= incoming().amount;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
